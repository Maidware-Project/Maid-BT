# Per-machine bluetooth override.
# Copy to ~/.config/bluetooth-buds.conf and edit (install.sh can do it).
# Find values with:
#   bluetoothctl devices          # pick your earbuds MAC
#   pactl list short sinks        # fallback (speakers/DAC) NAME - not the index

BUDS_MAC="AA:BB:CC:DD:EE:FF"
FALLBACK_SINK=""
# Opt out of the app pause/resume cycle with: APP_CYCLE=0
# Opt out of auto-connecting other paired headsets with: AUDIO_PRIORITY=0
# Pin LDAC after every switch (needs LDAC headset) with: QUALITY_LOCK=1
# Dual-connection buds (phone+PC at once, PC stops fighting) with: MULTIPOINT=1

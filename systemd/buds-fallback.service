[Unit]
Description=Bluetooth earbuds watcher (auto-connect + fallback sink park)
After=pipewire.service wireplumber.service bluetooth.service
Wants=pipewire.service wireplumber.service

[Service]
ExecStart=%h/.local/bin/buds-fallback.sh
Restart=always
RestartSec=3
# least privilege: D-Bus + rfkill only, configs read-only; the only fs
# write is the MaidLogs audit file
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/MaidLogs
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=default.target

    if len(sys.argv) < 2 or sys.argv[1] == "run":
        Daemon(cfg).run()
    elif sys.argv[1] == "status":
        cmd_status(cfg, as_json="--json" in sys.argv[2:])
    elif sys.argv[1] == "bluev":
        cmd_bluev(cfg, as_json="--json" in sys.argv[2:])
    elif sys.argv[1] == "scan":
        cmd_scan()
    elif sys.argv[1] == "model":
        cmd_model(" ".join(sys.argv[2:]) or None)
    elif sys.argv[1] == "bugreport":
        cmd_bugreport(cfg, full="--full" in sys.argv)
    elif sys.argv[1] == "route-mic":
        from maid_core.audio import COMMS_PATTERNS
        target = sys.argv[2] if len(sys.argv) > 2 else (
            audio.default_source_name())
        if not target:
            print("no default source found")
        else:
            print(f"moved {audio.move_recording_to_source(COMMS_PATTERNS, target)} "
                  f"mic stream(s) to {target}")
    else:
        print(__doc__)


if __name__ == "__main__":
    main()

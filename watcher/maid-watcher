#!/usr/bin/env python3
"""maid-watcher - earbuds manager daemon for KDE Plasma (BlueZ + PipeWire).
Maid BT: Maid Watcher BlueV Protocol - BT state persistence/restore across sleep, resume, and startup.

XDG-autostart friendly, no systemd/OpenRC dependency. Uses only APIs that
are stable across Plasma versions (BlueZ D-Bus, MPRIS, freedesktop
notifications, KDE Connect telephony signal).

Usage:
  maid-watcher run      start daemon
  maid-watcher status [--json]
                        show managed devices, connection, battery (json for
                        scripts: one line, plain values)
  maid-watcher bluev [--json]
                        show BlueV/maid-watcher feature-detection capabilities
  maid-watcher scan     list nearby BT audio devices for config
  maid-watcher model [NAME]  check a name against the model database
                        (no NAME: all configured devices)
  maid-watcher bugreport [--full]  diagnostics bundle for bug reports
  maid-watcher route-mic [SOURCE]  move chat-app mics to SOURCE
                        (default: default source) to free the BT mic
"""
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

from maid_core import config as config_mod
from maid_core import models
from maid_core import notify

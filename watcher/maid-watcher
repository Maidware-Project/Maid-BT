from maid_core.flaps import CALM_S, FlapWatch
from maid_core.bluev import BlueV

DISCORD_PATTERNS = ("discord", "vesktop", "webcord", "vencord")

STATE_PATH = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "maid-watcher", "bt-state.json")


def _load_bt_state():
    try:
        with open(STATE_PATH) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            return {}
        return data
    except (OSError, ValueError, TypeError):
        return {}


def _save_bt_state(data):
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, STATE_PATH)
    except OSError:
        pass


class Daemon:
    def __init__(self, cfg):
        self.cfg = cfg
        self.devices = {d["mac"]: d for d in cfg["devices"]}
        # Laptops run on battery: back the radio off (longer delays,
        # fewer attempts) instead of hammering BlueZ.
        self.laptop = config_mod.laptop_mode(cfg)
        rc = dict(cfg["reconnect"])
        if self.laptop:
            rc["initial_delay_s"] = max(rc["initial_delay_s"], 10)
            rc["max_delay_s"] = max(rc["max_delay_s"], 300)
            rc["give_up_after"] = min(rc.get("give_up_after", 10), 6)
        self.rc = rc
        self.session_bus = dbus.SessionBus()
        self.system_bus = dbus.SystemBus()
        self.monitor = DeviceMonitor(self.system_bus, self.on_conn_change)
        for mac in self.devices:
            self.monitor.watch(mac)
        self.retry = {}  # mac -> [fails, next_try]
        self._retry_src = {}  # mac -> GLib source id of the pending retry
        self._last_op = {}  # (mac, kind) -> last BT op timestamp
        self._wedged = {}  # mac -> consecutive failed enforces
        self.flap = FlapWatch()  # mac -> disconnect-storm state (tug-of-war)
        self._was_hot = set()  # macs whose stand-down ends on a later tick
        self._defer_a2dp = set()  # macs whose a2dp switch waits for sound
        self._docked = set()  # macs recognized docked (in charging case)
        self._dock_next = {}  # mac -> epoch of next docked recheck
        self.quirks = {}  # mac -> models.lookup() result (info only)
        self.call_muted = []
        self.call_paused = []
        self.call_timer = None
        if cfg["calls"]["enabled"]:
            self.watcher = CallWatcher(self.session_bus,
                                       self.on_call_start, self.on_call_end)
        else:
            self.watcher = None
        self.battery = BatteryWatch(cfg, self.monitor)
        # Cached external probes (subprocess-heavy): avoid repeated
        # kdeconnect/ip calls every tick when fallback features run.
        self._phones_cache = (0.0, True)   # (ts, reachable)
        self._bnep_cache = (0.0, False)    # (ts, up)
        # Maid BT: Maid Watcher BlueV Protocol - BT state persistence + restore.
        self._bt_state = _load_bt_state()
        self._restoring = False
        self._restore_pending = False
        self._save_state_idle = None
        # BlueV: state/confidence model (phone hints + local probing/policy).
        self.bluev = BlueV(cfg)
        try:
            self.system_bus.add_signal_receiver(
                self._on_adapter_props_changed,
                signal_name="PropertiesChanged",
                dbus_interface="org.freedesktop.DBus.Properties",
                arg0="org.bluez.Adapter1")
        except Exception:
            pass
        try:
            self.system_bus.add_signal_receiver(
                self._on_prepare_for_sleep,
                signal_name="PrepareForSleep",
                dbus_interface="org.freedesktop.login1.Manager")
        except Exception:
            pass

    # -- Maid BT: Maid Watcher BlueV Protocol (state persistence/restore) --
    def _adapter_path(self):
        try:
            return getattr(self.bluev, "adapter_path", None) or ((self.cfg.get("bluev") or {}).get("adapter_path")) or "/org/bluez/hci0"
        except Exception:
            return "/org/bluez/hci0"

    def _list_adapter_paths(self):
        paths = []
        try:
            obj = self.system_bus.get_object("org.bluez", "/")
            om = dbus.Interface(obj, "org.freedesktop.DBus.ObjectManager")
            objs = om.GetManagedObjects()
            for path, ifaces in objs.items():
                if "org.bluez.Adapter1" in ifaces:
                    paths.append(str(path))
        except Exception:
            pass
        if not paths:
            # fallback to configured/default adapter
            paths = [self._adapter_path()]
        # prefer configured adapter first for backward-compatible behavior
        pref = self._adapter_path()
        paths = sorted(set(paths), key=lambda p: (0 if p == pref else 1, p))
        return paths

    def _get_adapter_powered_at(self, path):
        try:
            obj = self.system_bus.get_object("org.bluez", path)
            props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
            return bool(props.Get("org.bluez.Adapter1", "Powered"))
        except Exception:
            return None

    def _set_adapter_powered_at(self, path, powered):
        try:
            obj = self.system_bus.get_object("org.bluez", path)
            props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
            props.Set("org.bluez.Adapter1", "Powered", dbus.Boolean(bool(powered)))
            return True
        except Exception:
            return False

    def _get_adapter_powered(self):
        return self._get_adapter_powered_at(self._adapter_path())

    def _set_adapter_powered(self, powered):
        return self._set_adapter_powered_at(self._adapter_path(), powered)

    def _connected_devices_on_adapter(self, adapter_path):
        # Best-effort: infer from managed BlueZ device objects under adapter.
        connected = []
        want = set(self.devices.keys())
        try:
            obj = self.system_bus.get_object("org.bluez", "/")
            om = dbus.Interface(obj, "org.freedesktop.DBus.ObjectManager")
            objs = om.GetManagedObjects()
            prefix = str(adapter_path).rstrip("/") + "/dev_"
            for path, ifaces in objs.items():
                if not str(path).startswith(prefix):
                    continue
                dev = ifaces.get("org.bluez.Device1") or {}
                addr = str(dev.get("Address", "")).upper()
                if addr in want and bool(dev.get("Connected", False)):
                    connected.append(addr)
        except Exception:
            # fallback to monitor check (single-adapter style)
            for mac in self.devices:
                if self.monitor.is_connected(mac):
                    connected.append(mac)
        # dedupe preserving order
        seen = set()
        out = []
        for m in connected:
            if m not in seen:
                seen.add(m)
                out.append(m)
        return out

    def _current_state_snapshot(self):
        adapters = {}
        for ap in self._list_adapter_paths():
            adapters[ap] = {
                "powered": self._get_adapter_powered_at(ap),
                "connected": self._connected_devices_on_adapter(ap),
            }
        # keep legacy top-level fields for backward compatibility
        primary = self._adapter_path()
        legacy = adapters.get(primary, {"powered": None, "connected": []})
        return {
            "adapters": adapters,
            "adapter_powered": legacy.get("powered"),
            "connected": legacy.get("connected", []),
        }

    def _normalized_saved_adapters(self):
        state = self._bt_state or {}
        adapters = state.get("adapters")
        if isinstance(adapters, dict) and adapters:
            out = {}
            for ap, rec in adapters.items():
                if not isinstance(rec, dict):
                    continue
                connected = rec.get("connected") or []
                if not isinstance(connected, list):
                    connected = []
                out[str(ap)] = {
                    "powered": rec.get("powered"),
                    "connected": [str(m).upper() for m in connected if str(m)],
                }
            if out:
                return out
        # legacy format
        connected = state.get("connected") or []
        if not isinstance(connected, list):
            connected = []
        ap = self._adapter_path()
        return {
            ap: {
                "powered": state.get("adapter_powered"),
                "connected": [str(m).upper() for m in connected if str(m)],
            }
        }

    def _save_state_now(self):
        self._save_state_idle = None
        try:
            self._bt_state = self._current_state_snapshot()
            _save_bt_state(self._bt_state)
        except Exception:
            pass
        return False

    def _schedule_save_state(self, delay_s=2):
        if self._save_state_idle is not None:
            try:
                GLib.source_remove(self._save_state_idle)
            except Exception:
                pass
        self._save_state_idle = GLib.timeout_add_seconds(delay_s, self._save_state_now)

    def _on_adapter_props_changed(self, iface, changed, invalidated=None, path=None):
        if iface != "org.bluez.Adapter1":
            return
        if "Powered" in changed:
            self._schedule_save_state(1)

    def _on_prepare_for_sleep(self, sleeping):
        try:
            sleeping = bool(sleeping)
        except Exception:
            return
        if sleeping:
            notify.audit("BlueV: sleep - snapshotting BT state")
            # Snapshot immediately (best effort) before suspend.
            self._save_state_now()
        else:
            notify.audit("BlueV: resume - restoring BT state")
            self._schedule_restore(initial_delay_s=3)

    def _schedule_restore(self, initial_delay_s=2):
        if self._restoring:
            self._restore_pending = True
            return
        GLib.timeout_add_seconds(initial_delay_s, self._begin_restore)

    def _begin_restore(self):
        self._restoring = True
        self._restore_pending = False
        self._restore_attempt = 0
        self._do_restore_step()
        return False

    def _do_restore_step(self):
        # Wait for adapter(s)/BlueZ to be ready, then restore state.
        adapter_paths = self._list_adapter_paths()
        ready = [ap for ap in adapter_paths if self._get_adapter_powered_at(ap) is not None]
        if not ready:
            self._restore_attempt += 1
            if self._restore_attempt <= 15:
                GLib.timeout_add_seconds(2, self._do_restore_step)
                return False
            notify.audit("BlueV: adapter(s) not ready, giving up wait")
            self._restoring = False
            if self._restore_pending:
                self._restore_pending = False
                self._schedule_restore(2)
            return False

        saved = self._normalized_saved_adapters()
        # Restore adapter power states (best effort) per known adapter.
        needs_power_on_delay = False
        for ap in adapter_paths:
            rec = saved.get(ap)
            if not rec:
                continue
            saved_powered = rec.get("powered")
            cur = self._get_adapter_powered_at(ap)
            if saved_powered is True and cur is False:
                notify.audit(f"BlueV: powering adapter on ({ap})")
                self._set_adapter_powered_at(ap, True)
                needs_power_on_delay = True
            elif saved_powered is False and cur is True:
                # Respect prior intent: leave intentionally-off adapters off.
                notify.audit(f"BlueV: adapter was off before sleep, leaving off ({ap})")
                self._set_adapter_powered_at(ap, False)
            elif saved_powered is False and cur is False:
                notify.audit(f"BlueV: adapter remains off ({ap})")

        if needs_power_on_delay:
            GLib.timeout_add_seconds(3, self._restore_connect_saved_all)
            return False

        self._restore_connect_saved_all()
        return False

    def _restore_connect_saved_all(self):
        saved = self._normalized_saved_adapters()
        # Merge saved connected devices across adapters that are currently powered on.
        to_reconnect = []
        seen = set()
        for ap, rec in saved.items():
            if self._get_adapter_powered_at(ap) is False:
                continue
            for mac in (rec.get("connected") or []):
                mac = str(mac).upper()
                if mac and mac not in seen:
                    seen.add(mac)
                    to_reconnect.append(mac)
        # Fallback: if no per-adapter info matched, try legacy merged list
        if not to_reconnect:
            legacy = (self._bt_state or {}).get("connected") or []
            if isinstance(legacy, list):
                to_reconnect = [str(m).upper() for m in legacy if str(m)]

        self._restore_connect_saved(to_reconnect)
        return False

    def _restore_connect_saved(self, saved_connected):
        stagger = 0
        for mac in saved_connected:
            mac = str(mac).upper()
            if mac not in self.devices:
                continue
            dev = self.devices[mac]
            if self.monitor.is_connected(mac):
                continue
            if mac in self._docked:
                continue
            if self.flap.hot(mac, time.time()):
                continue
            if not dev.get("auto_reconnect", True):
                continue
            stagger += 1
            notify.audit(f"BlueV: reconnect {dev.get('name', mac)}")
            self.retry[mac] = [0, time.time()]
            if self._retry_src.get(mac) is None:
                # Stagger slightly per device; _maybe_reconnect also serializes.
                delay = max(1, min(stagger, 5))
                self._retry_src[mac] = GLib.timeout_add_seconds(
                    delay, self._maybe_reconnect, mac)
        self._restoring = False
        if self._restore_pending:
            self._restore_pending = False
            self._schedule_restore(2)
        return False

    # -- connection management -----------------------------------------
    def on_conn_change(self, mac, connected):
        dev = self.devices.get(mac, {})
        name = dev.get("name", mac)
        if connected:
            if mac in self._docked:
                self._docked.discard(mac)
                self._dock_next.pop(mac, None)
                notify.audit(f"case state cleared: {name} connected again")
            notify.audit(f"connected: {name}")
            self.bluev.note_connected_pc(mac)
            self._schedule_save_state(2)
            # no popup: buds returning is not news (the fallback parks a
            # notice on the disconnect). every radio blink popping a
            # balloon read as the watcher being annoying.
            now = time.time()
            hot = self.flap.hot(mac, now)
            hit = models.lookup(name)
            if hit["brand"]:
                self.quirks[mac] = hit
                notify.audit(f"model db: {name} -> {hit['brand']} "
                             f"{hit['model']} ["
                             f"{', '.join(hit['quirks']) or 'no quirks'}]")
            if not self.flap.hot(mac, now):
                # A mid-storm connect must not clear the backoff: the
                # drop that follows would restart it from five seconds.
                # A link that holds earns the clear in _flap_pass.
                self.retry.pop(mac, None)
            if dev.get("prefer_profile") == "a2dp" and not hot:
                # The profile switch waits for actual sound: calling it
                # on every radio event is the "sudden switch" heard on
                # charging and phone wake-ups, when nothing is playing.
                self._defer_a2dp.add(mac)
            if not hot:
                GLib.timeout_add_seconds(4, self._route_after_connect)
        else:
            notify.audit(f"disconnected: {name}")
            self.bluev.note_pc_disconnected(mac)
            self._schedule_save_state(2)
            # no popup here: buds-fallback.sh already fires the one
            # "Earbuds disconnected / audio parked" notice - two daemons
            # popping duplicates reads like a glitch
            now = time.time()
            self.flap.note_down(mac, now)
            self._defer_a2dp.discard(mac)     # buds gone: no switch to finish
            if self.flap.hot(mac, now):
                # Tug-of-war: the buds bounce between the phone and this
                # PC (a charging phone waking up does exactly this).
                # Chasing every drop is what heard as a sudden switch, so
                # the watcher stands down - one notice, then no reconnect
                # race, no profile switches, no routing - and picks back
                # up in _flap_pass when the calm is over.
                if self.flap.stand_down(mac, now):
                    notify.audit(f"flap storm on {name}: standing down "
                                 f"{int(CALM_S)}s, waiting for calm")
                    notify.send("Buds pulled both ways",
                                "The buds are bouncing between your phone "
                                "and this PC. I'll wait for things to "
                                "settle - audio moves only when something "
                                "actually plays.")
                self.retry.pop(mac, None)
                return
            if dev.get("auto_reconnect", True):
                self._queue_reconnect(mac)

    def _queue_reconnect(self, mac):
        "The ordinary, unhurried reconnect: the first wait, then _maybe_reconnect."
        # BlueZ can fire "disconnected" several times per dropped link
        # (profile teardown). Each event queueing its own chain ran the
        # connect attempts in parallel - a piece of the transport
        # wedging. One chain per device: if one is already scheduled,
        # this is a duplicate event, not a new cycle.
        if self._retry_src.get(mac) is not None:
            return
        delay = self.rc["initial_delay_s"]
        self.retry[mac] = [0, time.time() + delay]
        self._retry_src[mac] = GLib.timeout_add_seconds(
            delay + 1, self._maybe_reconnect, mac)

    def _bt_op_allowed(self, mac, kind):
        # One BT operation per device per cooldown window. Slow is
        # smooth: hammering BlueZ/PipeWire wedges transports.
        import time
        key = (mac, kind)
        now = time.time()
        cooldown = self.rc.get("op_cooldown_s", 10)
        if now - self._last_op.get(key, 0) < cooldown:
            return False
        self._last_op[key] = now
        return True

    def _enforce_a2dp(self, mac, attempt=0):
        # Card appears in PipeWire slightly after the BlueZ connect;
        # retry a few times instead of assuming one shot lands.
        # Despite the name, this enforces the preferred high-quality profile:
        # A2DP for classic devices, or BAP/LE Audio when enabled/active.
        if self.flap.hot(mac, time.time()):
            return False     # storm running: a profile change now is noise
        if self.monitor.is_connected(mac):
            if not self._bt_op_allowed(mac, "profile"):
                GLib.timeout_add_seconds(self.rc.get("op_cooldown_s", 10),
                                         self._enforce_a2dp, mac, attempt)
                return False
            cur = audio.active_profile(mac) or ""
            if cur.startswith("bap") and getattr(audio, "_le_audio_enabled", lambda: False)():
                self._wedged.pop(mac, None)
                return False
            if audio.set_profile_a2dp(mac):
                self._wedged.pop(mac, None)
                return False
            if attempt < 2:
                GLib.timeout_add_seconds(3, self._enforce_a2dp, mac,
                                         attempt + 1)
            else:
                holders = audio.bt_mic_holders(mac)
                if holders:
                    who = ", ".join(a if a != "?" else n
                                    for a, n in holders)
                    notify.audit(f"profile blocked, bt mic held by: {who}")
                    notify.send("Can't switch to high quality",
                                f"Microphone in use by {who} - "
                                "leave the call (or quit it) and I will retry.")
                else:
                    notify.audit("profile switch failed with mic free "
                                 "(transport wedged?)")
                    fails = self._wedged.get(mac, 0) + 1
                    self._wedged[mac] = fails
                    if fails >= 3 and self.cfg.get("recover", {}).get(
                            "adapter_cycle", True):
                        self._wedged[mac] = 0
                        notify.audit("overload recovery: cycling BT adapter")
                        notify.send("Audio link stuck",
                                    "Cycling the Bluetooth adapter once "
                                    "to clear it.")
                        from maid_core.bluez import DeviceMonitor as _DM
                        _DM.power_cycle()
        return False

    def _maybe_reconnect(self, mac):
        self._retry_src.pop(mac, None)     # this chain fired; the slot is free
        if mac not in self.retry:
            return False
        if self.monitor.is_connected(mac):
            # A switch that drops again must not restart the escalation,
            # so the count only clears on a link that held (see _flap_pass).
            if not self.flap.hot(mac, time.time()):
                self.retry.pop(mac, None)
            return False
        if self.flap.hot(mac, time.time()):
            return False     # tug-of-war: never race the phone for the buds
        # BlueV: phone hint says connected to phone -> don't race it.
        try:
            if self.bluev.phone_state(mac) == "connected_to_phone":
                now = time.time()
                if now - self._last_op.get((mac, "bluev_defer_log"), 0) >= 120:
                    self._last_op[(mac, "bluev_defer_log")] = now
                    notify.audit(f"BlueV: {self.devices.get(mac, {}).get('name', mac)} connected to phone, deferring reconnect")
                self._retry_src[mac] = GLib.timeout_add_seconds(30, self._maybe_reconnect, mac)
                return False
        except Exception:
            pass
        # Serialize connects: BlueZ rejects overlapping connects
        # (InProgress) and parallel A2DP setups flap PipeWire. Highest
        # priority pending device goes first; the rest wait their turn.
        pending = [m for m in self.retry
                   if not self.monitor.is_connected(m)]
        pending.sort(key=lambda m: self.devices.get(m, {}).get("priority",
                                                                 99))
        if not pending or pending[0] != mac:
            GLib.timeout_add_seconds(5, self._maybe_reconnect, mac)
            return False
        fails, _ = self.retry[mac]
        rc = self.rc
        if not self._bt_op_allowed(mac, "connect"):
            GLib.timeout_add_seconds(rc.get("op_cooldown_s", 10),
                                     self._maybe_reconnect, mac)
            return False
        if fails >= rc["give_up_after"]:
            # Safety valve, not abandonment: stop hammering BlueZ. The
            # dock probe now decides what happened: buds in the charging
            # case stand down quietly; anything else keeps the manual
            # retry notification. Any new disconnect restarts the cycle.
            self.retry.pop(mac, None)
            self._dock_check(mac)
            return False
        self.monitor.connect(mac)
        delay = min(rc["initial_delay_s"] * (2 ** (fails + 1)),
                    rc["max_delay_s"])
        self.retry[mac] = [fails + 1, time.time() + delay]
        GLib.timeout_add_seconds(delay, self._maybe_reconnect, mac)
        return False

    # -- charging-case recognition --------------------------------------
    # A closed charging case powers the buds down: they never advertise
    # and never answer pages. Opening the lid, they advertise within
    # seconds. One passive, MAC-filtered discovery window therefore
    # tells "docked" from "lost" - without a single connect attempt.
    def _dock_check(self, mac):
        """Dock probe in a background thread; verdict lands on the loop."""
        import threading
        window = self.cfg.get("case_detect", {}).get("probe_s", 8)

        def worker():
            verdict = None
            try:
                verdict = DockProbe(mac).visible(window_s=window)
            except Exception as exc:  # noqa: BLE001 - never kill the loop
                notify.audit(f"dock probe error: {exc}")
            GLib.idle_add(self._dock_verdict, mac, verdict)

        threading.Thread(target=worker, daemon=True).start()

    def _dock_verdict(self, mac, verdict):
        if self.monitor.is_connected(mac):
            self.bluev.note_connected_pc(mac)
            return False  # live again: beats any verdict
        dev = self.devices.get(mac, {})
        name = dev.get("name", mac)
        try:
            self.bluev.refresh_hints()
            bstate, breason = self.bluev.resolve(mac, False, verdict)
        except Exception:
            bstate, breason = (None, None)

        # Phone hint: if connected to phone, do not claim docked or give-up-reconnect; defer.
        if bstate == "connected_to_phone":
            if mac in self._docked:
                self._docked.discard(mac)
                self._dock_next.pop(mac, None)
            notify.audit(f"BlueV: {name} connected to phone, not docked")
            return False

        if verdict is True:
            self.bluev.note_out_evidence(mac, "probe_advertising")
            if mac in self._docked:
                # was docked, now advertising: the case opened. Fast resume.
                self._docked.discard(mac)
                self._dock_next.pop(mac, None)
                notify.audit(f"case opened: {name} advertising again, reconnecting")
                self.retry[mac] = [0, time.time()]
                GLib.timeout_add_seconds(1, self._maybe_reconnect, mac)
                return False
            # out/available but refusing to connect: keep existing give-up UX path below if this came from give-up flow
            # (caller context varies; fall through to manual handling)
        elif verdict is False:
            # Silent probe: use BlueV smoothing/confirmations before declaring docked.
            if bstate == "docked":
                if mac not in self._docked:
                    self._docked.add(mac)
                    self._dock_next[mac] = 0.0
                    notify.audit(f"buds docked (BlueV): {name} (silent probes, standing down)")
                    notify.send(f"{config_mod.short_name(dev)} is in its case",
                                "Standing down. They reconnect on their own when you take them out.")
                return False
            # not yet confirmed docked: recheck later without claiming docked
            self._dock_next[mac] = time.time() + self.cfg.get("case_detect", {}).get("recheck_s", 120)
            notify.audit(f"BlueV: {name} silent but unconfirmed ({breason}), will recheck")
            return False
        else:
            # Unknown probe result (scan unavailable): never claim docked
            if mac in self._docked:
                # keep prior docked belief until contradicted, but don't strengthen
                return False

        # verdict True but not previously docked: device is/was advertising (out/available).
        # Avoid claiming docked; keep UX quiet and let normal reconnect logic apply if applicable.
        if verdict is True:
            notify.audit(f"BlueV: {name} out/available (not docked)")
            return False
        # verdict None or other non-docked outcome: keep manual retry UX quiet
        notify.audit(f"reconnect gave up: {name}")
        return False

    def case_rewatch(self):
        """Docked devices: slow lid-open recheck, self-connect backstop
        for when buds wake up and join the phone instead of this PC."""
        cd = self.cfg.get("case_detect", {})
        if not cd.get("enabled", True):
            return
        interval = cd.get("recheck_s", 120)
        window = cd.get("probe_s", 8)
        now = time.time()
        try:
            self.bluev.refresh_hints()
        except Exception:
            pass
        # Recheck docked devices and also devices in unconfirmed-silent state tracked by _dock_next
        macs = set(self._docked)
        for mac, st in getattr(self.bluev, "devices", {}).items():
            if st.state in ("unknown",) and st.docked_silent_count > 0:
                macs.add(mac)
        if not macs:
            return
        for mac in list(macs):
            if self.monitor.is_connected(mac):
                self._docked.discard(mac)
                continue
            try:
                if self.bluev.phone_state(mac) == "connected_to_phone":
                    self._docked.discard(mac)
                    continue
            except Exception:
                pass
            if now < self._dock_next.get(mac, 0):
                continue
            self._dock_next[mac] = now + interval + window
            self._dock_check(mac)

    # -- call mode --------------------------------------------------------
    def on_call_start(self, info):
        notify.audit(f"call started: {info}")
        notify.send("Incoming call", info)
        if self.cfg["calls"]["pause_media"]:
            self.call_paused = media.pause_all(self.session_bus)
        if self.cfg["calls"]["mute_discord"]:
            self.call_muted = audio.find_app_streams(DISCORD_PATTERNS)
            for node in self.call_muted:
                audio.set_mute(node, True)
        max_s = self.cfg["calls"]["max_call_mode_s"]
        if self.call_timer:
            GLib.source_remove(self.call_timer)
        self.call_timer = GLib.timeout_add_seconds(
            max_s, self._call_safety_timeout)

    def _call_safety_timeout(self):
        self.call_timer = None
        self.on_call_end("safety timeout")
        return False

    def on_call_end(self, reason):
        if self.call_timer:
            GLib.source_remove(self.call_timer)
            self.call_timer = None
        for node in self.call_muted:
            audio.set_mute(node, False)
        self.call_muted = []
        media.resume(self.session_bus, self.call_paused)
        self.call_paused = []
        notify.audit(f"call ended: {reason}")
        notify.send("Call ended", reason)

    # -- periodic ---------------------------------------------------------
    def tick(self):
        self._maybe_reload()
        self.battery.poll(list(self.devices.values()))
        self.case_rewatch()
        self.fallback_grab()
        self._flap_pass()
        self._deferred_audio_pass()
        self.route_comms()
        self.bt_fallback_watch()
        return True

    def _flap_pass(self):
        """Once a tick: storms end, links that held clean their history,
        and the audio work a storm held back re-arms."""
        now = time.time()
        for mac, dev in self.devices.items():
            name = dev.get("name", mac)
            if self.flap.hot(mac, now):
                self._was_hot.add(mac)
                continue
            if mac in self._was_hot:
                # The calm expired with nothing bouncing: the tug-of-war
                # is over and everything it froze comes back gently.
                self._was_hot.discard(mac)
                self.flap.forget(mac)
                self._wedged.pop(mac, None)
                if self.monitor.is_connected(mac):
                    notify.audit(f"{name} settled: watcher stands back up")
                    if dev.get("prefer_profile") == "a2dp":
                        self._defer_a2dp.add(mac)
                elif dev.get("auto_reconnect", True) \
                        and mac not in self._docked:
                    notify.audit(f"{name} settled: reconnect resumes")
                    self._queue_reconnect(mac)
            if self.monitor.is_connected(mac) and self.flap.settled(mac, now):
                # The link held long enough: old drops stop counting.
                self.retry.pop(mac, None)

    def _deferred_audio_pass(self):
        """The a2dp switch that waited for actual sound. Used to fire the
        moment BlueZ blinked, which the ears heard as a sudden switch on
        charging or phone wake-ups with nothing playing - now it lands
        when something is really playing."""
        if not self._defer_a2dp:
            return
        try:
            audible = audio.audible_now()
        except Exception:                 # audio stack hiccup: try next tick
            return
        if not audible:
            return
        for mac in list(self._defer_a2dp):
            self._defer_a2dp.discard(mac)
            dev = self.devices.get(mac, {})
            if not self.monitor.is_connected(mac):
                continue
            if self.flap.hot(mac, time.time()):
                self._defer_a2dp.add(mac)  # storms stay frozen until calm
                continue
            if dev.get("prefer_profile") == "a2dp":
                notify.audit(f"{dev.get('name', mac)}: audio is playing, "
                             "a2dp switch resumes")
                GLib.idle_add(self._enforce_a2dp, mac)
        self.route_comms()

    # ---- live config reload -------------------------------------------
    # The applet's config pages write ~/.config/maid-watcher/config.json on
    # every control change and on Apply. The daemon re-reads it on the next
    # tick so settings take effect without a service restart.
    def _conf_mtime(self):
        try:
            return os.path.getmtime(config_mod.CONFIG_PATH)
        except OSError:
            return None

    def _maybe_reload(self):
        mtime = self._conf_mtime()
        if mtime is None or mtime == getattr(self, "_conf_seen", None):
            return
        first = not hasattr(self, "_conf_seen")
        self._conf_seen = mtime
        if first:
            return
        try:
            cfg = config_mod.load()
        except Exception as exc:  # bad JSON etc. - keep running on old cfg
            notify.audit(f"config reload failed: {exc}")
            return
        try:
            self._apply_config(cfg)
            notify.audit("config reloaded")
        except Exception as exc:  # a bad apply must not kill the tick loop
            notify.audit(f"config apply failed: {exc}")

    def _apply_config(self, cfg):
        old_macs = set(self.devices)
        self.devices = {d["mac"]: d for d in cfg["devices"]}
        self.cfg = cfg
        self.battery = BatteryWatch(cfg, self.monitor)

        self.laptop = config_mod.laptop_mode(cfg)
        rc = dict(cfg["reconnect"])
        if self.laptop:
            rc["initial_delay_s"] = max(rc["initial_delay_s"], 10)
            rc["max_delay_s"] = max(rc["max_delay_s"], 300)
            rc["give_up_after"] = min(rc.get("give_up_after", 10), 6)
        self.rc = rc

        for mac in old_macs - set(self.devices):
            self.monitor.unwatch(mac)
            self.retry.pop(mac, None)
            self._wedged.pop(mac, None)
            self._docked.discard(mac)
            self._dock_next.pop(mac, None)
            self.quirks.pop(mac, None)
            self.flap.forget(mac)
            self._defer_a2dp.discard(mac)
            self._was_hot.discard(mac)
        for mac in self.devices:
            if mac not in old_macs:
                self.monitor.watch(mac)
                if self.monitor.is_connected(mac):
                    dev = self.devices[mac]
                    if dev.get("prefer_profile") == "a2dp":
                        # same gate as a connect: the switch waits for
                        # sound, a silent attach switches nothing
                        self._defer_a2dp.add(mac)
                elif self.devices[mac].get("auto_reconnect", True) \
                        and mac not in self._docked \
                        and mac not in self.retry:
                    self.retry[mac] = [0, time.time() + self.rc["initial_delay_s"]]
                    GLib.timeout_add_seconds(self.rc["initial_delay_s"] + 1,
                                             self._maybe_reconnect, mac)
        self.monitor.refresh()

    def bt_fallback_watch(self):
        # WiFi dead → Bluetooth instead (opt-in). When no phone is
        # reachable, offer the Bluetooth-tethering path once; when a
        # bnep link appears, refresh KDE Connect so everything resumes.
        if not self.cfg.get("bt_fallback", {}).get("enabled", False):
            return
        if self.phones_up():
            self._phone_down_ticks = 0
            self._bt_offered = False
            return
        self._phone_down_ticks = getattr(self, "_phone_down_ticks", 0) + 1
        if self._phone_down_ticks == 2 and not getattr(self, "_bt_offered",
                                                        False):
            self._bt_offered = True

            def _retry(_key):
                self._phone_down_ticks = 0
                self._bt_offered = False

            def _bt_how(_key):
                notify.send(
                    "Bluetooth instead",
                    "On the phone: pair Bluetooth with this PC, then turn "
                    "on Bluetooth tethering. I will pick it up from there.",
                    actions=[("retry", "Check again")],
                    on_action=_retry,
                    session_bus=self.session_bus)

            notify.send("Phone unreachable on WiFi",
                        "Calls, intents and sharing are paused.",
                        actions=[("retry", "Retry now"),
                                 ("bt", "Bluetooth instead")],
                        on_action=lambda k: _retry(k) if k == "retry"
                        else _bt_how(k),
                        session_bus=self.session_bus)
            notify.audit("phone unreachable on wifi, offered bluetooth path")
            return
        if self._phone_down_ticks >= 2 and self._bnep_up():
            import subprocess
            try:
                subprocess.run(["kdeconnect-cli", "--refresh"],
                               capture_output=True, timeout=30)
            except (subprocess.SubprocessError, FileNotFoundError):
                pass
            if self.phones_up():
                notify.send("Bluetooth link up",
                            "Phone reachable again - resuming.")
                notify.audit("phone back via bluetooth link")
                self._phone_down_ticks = 0
                self._bt_offered = False

    def _bnep_up(self=None, ttl_s=20):
        import subprocess
        # Backward-compatible: allow Daemon._bnep_up() in tests.
        if self is None or isinstance(self, (int, float)):
            if isinstance(self, (int, float)):
                ttl_s = self
            self = None
        now = time.time()
        if self is not None:
            ts, val = getattr(self, "_bnep_cache", (0.0, False))
            if now - ts < ttl_s:
                return val
        try:
            p = subprocess.run(["ip", "-o", "addr", "show"],
                               capture_output=True, text=True, timeout=10)
            up = any("bnep" in line and "inet " in line
                     for line in (p.stdout or "").splitlines())
        except (subprocess.SubprocessError, FileNotFoundError):
            up = False
        if self is not None:
            self._bnep_cache = (now, up)
        return up

    def _route_after_connect(self):
        self.route_comms()
        return False

    def route_comms(self):
        # Playback-only aligner: Discord/Vesktop streams stranded on a
        # non-default sink get moved to the default. Mic routing is
        # never touched. Runs on tick + on connect.
        if not self.cfg.get("route_comms", {}).get("enabled", True):
            return
        try:
            moved = audio.route_comms_to_default()
        except Exception:
            return
        if moved:
            notify.audit(f"routed {moved} chat stream(s) to default sink")

    def phones_up(self, ttl_s=30):
        """True if any paired KDE Connect phone is reachable (cached)."""
        now = time.time()
        ts, val = getattr(self, "_phones_cache", (0.0, True))
        if now - ts < ttl_s:
            return val
        import subprocess
        try:
            p = subprocess.run(["kdeconnect-cli", "-l"],
                               capture_output=True, text=True, timeout=15)
            reachable = any("reachable" in line.lower()
                            for line in p.stdout.splitlines())
        except (subprocess.SubprocessError, FileNotFoundError):
            reachable = True  # can't tell: assume up, never grab blindly
        self._phones_cache = (now, reachable)
        return reachable

    def fallback_grab(self):
        # Phone-down fallback (opt-in): if no phone is reachable and a
        # managed device sits disconnected, its link is probably free -
        # grab it instead of waiting for a manual switch.
        if not self.cfg.get("fallback_grab", {}).get("enabled", False):
            return
        if self.phones_up():
            return
        for mac, dev in self.devices.items():
            try:
                if self.bluev.phone_state(mac) == "connected_to_phone":
                    continue
            except Exception:
                pass
            if dev.get("auto_reconnect", True) \
                    and not self.monitor.is_connected(mac) \
                    and mac not in self.retry \
                    and mac not in self._docked:
                notify.audit(f"fallback grab (no phone up): "
                             f"{dev.get('name', mac)}")
                notify.send("Phone away",
                            f"Grabbing {dev.get('name', mac)} back")
                delay = self.rc["initial_delay_s"]
                self.retry[mac] = [0, time.time() + delay]
                GLib.timeout_add_seconds(delay + 1, self._maybe_reconnect,
                                         mac)

    def run(self):
        poll_s = max(30, self.cfg["battery"]["poll_s"])
        GLib.timeout_add_seconds(poll_s, self.tick)
        # initial: enforce profile on already-connected devices,
        # seed reconnect for managed devices that are already down
        # (no disconnect event will ever fire for these).
        for mac, dev in self.devices.items():
            if self.monitor.is_connected(mac):
                if dev.get("prefer_profile") == "a2dp":
                    self._enforce_a2dp(mac)
            elif dev.get("auto_reconnect", True) \
                    and mac not in self._docked:
                delay = self.rc["initial_delay_s"]
                self.retry[mac] = [0, time.time() + delay]
                GLib.timeout_add_seconds(delay + 1, self._maybe_reconnect,
                                         mac)

        # Maid BT: Maid Watcher BlueV Protocol - restore BT state on startup.
        self._schedule_restore(initial_delay_s=2)
        names = ", ".join(config_mod.short_name(d)
                        for d in self.devices.values()) or "no devices"
        notify.send("Maid Watcher started", f"watching: {names}")
        GLib.MainLoop().run()


def cmd_status(cfg, as_json=False):
    "One pass over the configured devices: text for people, json for scripts (see maid_core.report)."
    bus = dbus.SystemBus()
    mon = DeviceMonitor(bus, lambda *a: None)
    ct = config_mod.chassis_type()
    laptop = config_mod.laptop_mode(cfg)
    probe_case = cfg.get("case_detect", {}).get("enabled", True)
    probe_s = cfg.get("case_detect", {}).get("probe_s", 8)
    bluev = None
    try:
        bluev = BlueV(cfg)
        bluev.refresh_hints()
    except Exception:
        bluev = None
    rows = []
    for dev in cfg["devices"]:
        mac = dev["mac"]
        mon.watch(mac)
        holders = audio.mic_holders()
        connected = mon.is_connected(mac)
        battery = mon.battery_percent(mac)
        probe = None
        if connected:
            case = "n/a (connected)"
        elif probe_case:
            try:
                probe = DockProbe(mac).visible(window_s=probe_s)
            except Exception:
                probe = None
            case = {True: "out of case (advertising)",
                    False: "in charging case (silent)",
                    None: "unknown (scan unavailable)"}[probe]
        else:
            case = None
        bluev_info = None
        if bluev is not None:
            try:
                bstate, breason = bluev.resolve(mac, connected, probe)
                st = bluev.ensure(mac)
                bluev_info = st.snapshot() if hasattr(st, "snapshot") else {"state": bstate, "reason": breason}
                bluev_info["state"] = bstate
                bluev_info["reason"] = breason
            except Exception:
                bluev_info = None
        rows.append({
            "name": dev.get("name", mac),
            "mac": mac,
            "connected": connected,
            "profile": audio.active_profile(mac),
            "mic_text": ", ".join(a if a != "?" else n for a, n in holders) or "nobody",
            "holders": [n for a, n in holders],
            "battery": battery,
            "case": case,
            "bluev": bluev_info,
        })
    bluev_caps = bluev.capabilities() if bluev is not None and hasattr(bluev, "capabilities") else None
    if as_json:
        print(report.shape(ct, laptop, rows, bluev_caps))
        return
    print(report.text(ct, laptop, rows, bluev_caps))


def cmd_bluev(cfg, as_json=False):
    """Report BlueV/maid-watcher feature detection and runtime capabilities."""
    caps = {}
    try:
        bv = BlueV(cfg)
        bv.refresh_hints()
        caps = bv.capabilities() if hasattr(bv, "capabilities") else {}
    except Exception as exc:
        caps = {"bluev": False, "error": str(exc)}
    if as_json:
        print(json.dumps(caps, sort_keys=True))
        return
    if not caps:
        print("bluev: unavailable")
        return
    print("BlueV capabilities:")
    for k in sorted(caps):
        v = caps[k]
        print(f"  {k}: {v}")


def _bluez_alias(mac):
    """Live device name from BlueZ for a configured MAC, or "".
    bluetoothctl only; silent when BlueZ is down or the buds are away."""
    if not mac:
        return ""
    import subprocess
    try:
        p = subprocess.run(["bluetoothctl", "info", mac],
                           capture_output=True, text=True, timeout=6,
                           check=False)
    except (OSError, subprocess.SubprocessError):
        return ""
    for line in p.stdout.splitlines():
        line = line.strip()
        # Alias: is the buds' real advertised name; the leading
        # "Device <mac> (public)" line has none, and letterboxed
        # "(public)"/"(random)" tokens are not names
        if line.startswith("Alias:"):
            return line.split(":", 1)[1].strip()
        if line.startswith("Device ") and mac.lower() in line.lower():
            parts = line.split(None, 2)
            if len(parts) == 3 and not parts[2].startswith("("):
                return parts[2].strip()
    return ""


def cmd_model(name=None):
    """Look a device name up in the maid_core models database.

    Stored names can be placeholders ("My Earbuds") while the buds
    announce their real model name over Bluetooth. when a stored name
    does not resolve, the live BlueZ alias for the same MAC gets a
    lookup instead - that is the auto-recognize path the Equalizer
    page rides on."""
    if name:
        hit = models.lookup(name)
        shown = name
        if not hit["brand"]:
            mac = ""
            for d in config_mod.load()["devices"]:
                if name.lower() in {d.get("name", "").lower(),
                                    d.get("short", "").lower(),
                                    d.get("mac", "").lower()}:
                    mac = d.get("mac", "")
                    break
            live = _bluez_alias(mac)
            if live and live.lower() != name.lower():
                hit2 = models.lookup(live)
                if hit2["brand"]:
                    hit, shown = hit2, live
        hits = [(shown, hit)]
    else:
        hits = []
        for d in config_mod.load()["devices"]:
            shown = d.get("name", d["mac"])
            hit = models.lookup(d.get("name", ""))
            if not hit["brand"]:
                live = _bluez_alias(d.get("mac", ""))
                if live and live.lower() != shown.lower():
                    hit2 = models.lookup(live)
                    if hit2["brand"]:
                        shown, hit = live, hit2
            hits.append((shown, hit))
        if not hits:
            print("no configured devices - pass a name: "
                  "maid-watcher model 'Sony WF-1000XM5'")
            return
    for shown, hit in hits:
        if hit["brand"]:
            quirks = ", ".join(hit["quirks"]) or "none"
            print(f"{shown} -> {hit['brand']} {hit['model']}  quirks: {quirks}")
        else:
            print(f"{shown} -> not in the model database "
                  "(generic A2DP support applies)")


def cmd_scan():
    """List nearby BT audio devices. One passive discovery window first:
    bluetoothctl devices only reports devices BlueZ already knows, so
    fresh in-box earbuds would be invisible without a scan."""
    import subprocess
    import time as _time
    print("Scanning (make devices discoverable)...")
    proc = None
    try:
        proc = subprocess.Popen(["bluetoothctl", "scan", "on"],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
        _time.sleep(8)
        for mac, name in DeviceMonitor.scan_audio_devices():
            print(f"  {mac}  {name}")
    finally:
        if proc and proc.poll() is None:
            proc.terminate()


def _sh(*args, timeout=10):
    import subprocess
    try:
        p = subprocess.run(args, capture_output=True, text=True,
                           timeout=timeout)
        return p.stdout.strip().splitlines()[0] if p.stdout.strip() else ""
    except (subprocess.SubprocessError, FileNotFoundError, IndexError):
        return ""


def redact_mac(mac):
    """Keep vendor OUI, hide device-specific bytes: AA:BB:CC:**:**:FF."""
    parts = str(mac).split(":")
    if len(parts) != 6:
        return "** redacted **"
    return ":".join(parts[:3] + ["**", "**", parts[5]])


def cmd_bugreport(cfg, full=False):
    """Print the diagnostics bundle bug reports should include."""
    import platform
    print("### maid-watcher bugreport "
          + ("(FULL macs - trim before posting publicly)"
             if full else "(macs redacted)"))
    print(f"_os: {_sh('sh', '-c', '. /etc/os-release; echo $PRETTY_NAME')}")
    print(f"kernel: {platform.release()}")
    print(f"plasma: {_sh('plasmashell', '--version')}")
    print(f"bluez: {_sh('bluetoothctl', '--version')}")
    print(f"wireplumber: {_sh('sh', '-c', 'rpm -q wireplumber 2>/dev/null || dpkg -s wireplumber 2>/dev/null | grep Version || pacman -Q wireplumber 2>/dev/null')}")
    print(f"pipewire: {_sh('pw-dump', '--version')}")
    bus = dbus.SystemBus()
    mon = DeviceMonitor(bus, lambda *a: None)
    for dev in cfg["devices"]:
        mac = dev["mac"]
        mon.watch(mac)
        shown = mac if full else redact_mac(mac)
        print(f"device {dev.get('name', mac)} [{shown}]: "

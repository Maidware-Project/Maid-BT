#!/usr/bin/env python3
"""maid-watcher — earbuds manager daemon for KDE Plasma (BlueZ + PipeWire).

XDG-autostart friendly, no systemd/OpenRC dependency. Uses only APIs that
are stable across Plasma versions (BlueZ D-Bus, MPRIS, freedesktop
notifications, KDE Connect telephony signal).

Usage:
  maid-watcher run      start daemon
  maid-watcher status   show managed devices, connection, battery
  maid-watcher scan     list nearby BT audio devices for config
  maid-watcher bugreport [--full]  diagnostics bundle for bug reports
"""
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

from maid_core import config as config_mod
from maid_core import notify
from maid_core.bluez import DeviceMonitor
from maid_core import audio
from maid_core import media
from maid_core.calls import CallWatcher

DISCORD_PATTERNS = ("discord", "vesktop", "webcord", "vencord")


class Daemon:
    def __init__(self, cfg):
        self.cfg = cfg
        self.devices = {d["mac"]: d for d in cfg["devices"]}
        # Laptops run on battery: back the radio off (longer delays,
        # fewer attempts) instead of hammering BlueZ.
        self.laptop = config_mod.laptop_mode(cfg)
        rc = dict(cfg["reconnect"])
        if self.laptop:
            rc["initial_delay_s"] = max(rc["initial_delay_s"], 10)
            rc["max_delay_s"] = max(rc["max_delay_s"], 300)
            rc["give_up_after"] = min(rc.get("give_up_after", 10), 6)
        self.rc = rc
        self.session_bus = dbus.SessionBus()
        self.system_bus = dbus.SystemBus()
        self.monitor = DeviceMonitor(self.system_bus, self.on_conn_change)
        for mac in self.devices:
            self.monitor.watch(mac)
        self.retry = {}  # mac -> [fails, next_try]
        self.call_muted = []
        self.call_paused = []
        self.call_timer = None
        if cfg["calls"]["enabled"]:
            self.watcher = CallWatcher(self.session_bus,
                                       self.on_call_start, self.on_call_end)
        else:
            self.watcher = None
        from maid_core.battery import BatteryWatch
        self.battery = BatteryWatch(cfg, self.monitor)

    # -- connection management -----------------------------------------
    def on_conn_change(self, mac, connected):
        dev = self.devices.get(mac, {})
        name = dev.get("name", mac)
        if connected:
            notify.audit(f"connected: {name}")
            notify.send("Earbuds connected", name)
            self.retry.pop(mac, None)
            if dev.get("prefer_profile") == "a2dp":
                GLib.timeout_add_seconds(2, self._enforce_a2dp, mac)
        else:
            notify.audit(f"disconnected: {name}")
            notify.send("Earbuds disconnected", name)
            if dev.get("auto_reconnect", True):
                delay = self.rc["initial_delay_s"]
                self.retry[mac] = [0, time.time() + delay]
                GLib.timeout_add_seconds(delay + 1, self._maybe_reconnect, mac)

    def _enforce_a2dp(self, mac, attempt=0):
        # Card appears in PipeWire slightly after the BlueZ connect;
        # retry a few times instead of assuming one shot lands.
        if self.monitor.is_connected(mac):
            if audio.set_profile_a2dp(mac):
                return False
            if attempt < 2:
                GLib.timeout_add_seconds(3, self._enforce_a2dp, mac,
                                         attempt + 1)
        return False

    def _maybe_reconnect(self, mac):
        if mac not in self.retry or self.monitor.is_connected(mac):
            self.retry.pop(mac, None)
            return False
        # Serialize connects: BlueZ rejects overlapping connects
        # (InProgress) and parallel A2DP setups flap PipeWire. Highest
        # priority pending device goes first; the rest wait their turn.
        pending = [m for m in self.retry
                   if not self.monitor.is_connected(m)]
        pending.sort(key=lambda m: self.devices.get(m, {}).get("priority",
                                                                 99))
        if not pending or pending[0] != mac:
            GLib.timeout_add_seconds(5, self._maybe_reconnect, mac)
            return False
        fails, _ = self.retry[mac]
        rc = self.rc
        if fails >= rc["give_up_after"]:
            # Safety valve, not abandonment: stop hammering BlueZ (and the
            # phone that may be holding the link) and tell the user to
            # reconnect manually. Any new disconnect event restarts the
            # cycle. Tune via reconnect.give_up_after / max_delay_s.
            name = self.devices.get(mac, {}).get("name", mac)

            def _retry_now(_key, _mac=mac):
                self.retry[_mac] = [0, time.time()]
                GLib.timeout_add_seconds(1, self._maybe_reconnect, _mac)

            notify.audit(f"reconnect gave up: {name}")
            notify.send("Giving up reconnect",
                        f"{name} — tap to retry, or reconnect manually",
                        "critical",
                        actions=[("retry", "Reconnect now")],
                        on_action=_retry_now,
                        session_bus=self.session_bus)
            self.retry.pop(mac, None)
            return False
        self.monitor.connect(mac)
        delay = min(rc["initial_delay_s"] * (2 ** (fails + 1)),
                    rc["max_delay_s"])
        self.retry[mac] = [fails + 1, time.time() + delay]
        GLib.timeout_add_seconds(delay, self._maybe_reconnect, mac)
        return False

    # -- call mode --------------------------------------------------------
    def on_call_start(self, info):
        notify.audit(f"call started: {info}")
        notify.send("Incoming call", info)
        if self.cfg["calls"]["pause_media"]:
            self.call_paused = media.pause_all(self.session_bus)
        if self.cfg["calls"]["mute_discord"]:
            self.call_muted = audio.find_app_streams(DISCORD_PATTERNS)
            for node in self.call_muted:
                audio.set_mute(node, True)
        max_s = self.cfg["calls"]["max_call_mode_s"]
        if self.call_timer:
            GLib.source_remove(self.call_timer)
        self.call_timer = GLib.timeout_add_seconds(
            max_s, self._call_safety_timeout)

    def _call_safety_timeout(self):
        self.call_timer = None
        self.on_call_end("safety timeout")
        return False

    def on_call_end(self, reason):
        if self.call_timer:
            GLib.source_remove(self.call_timer)
            self.call_timer = None
        for node in self.call_muted:
            audio.set_mute(node, False)
        self.call_muted = []
        media.resume(self.session_bus, self.call_paused)
        self.call_paused = []
        notify.audit(f"call ended: {reason}")
        notify.send("Call ended", reason)

    # -- periodic ---------------------------------------------------------
    def tick(self):
        self.battery.poll(list(self.devices.values()))
        return True

    def run(self):
        poll_s = max(30, self.cfg["battery"]["poll_s"])
        GLib.timeout_add_seconds(poll_s, self.tick)
        # initial: enforce profile on already-connected devices,
        # seed reconnect for managed devices that are already down
        # (no disconnect event will ever fire for these).
        for mac, dev in self.devices.items():
            if self.monitor.is_connected(mac):
                if dev.get("prefer_profile") == "a2dp":
                    self._enforce_a2dp(mac)
            elif dev.get("auto_reconnect", True):
                delay = self.rc["initial_delay_s"]
                self.retry[mac] = [0, time.time() + delay]
                GLib.timeout_add_seconds(delay + 1, self._maybe_reconnect,
                                         mac)
        notify.send("Maid Watcher started",
                    f"watching {len(self.devices)} device(s)")
        GLib.MainLoop().run()


def cmd_status(cfg):
    bus = dbus.SystemBus()
    mon = DeviceMonitor(bus, lambda *a: None)
    ct = config_mod.chassis_type()
    print(f"chassis:   {ct} "
          f"(laptop mode {'on' if config_mod.laptop_mode(cfg) else 'off'})")
    for dev in cfg["devices"]:
        mac = dev["mac"]
        mon.watch(mac)
        print(f"{dev.get('name', mac)} [{mac}]")
        print(f"  connected: {mon.is_connected(mac)}")
        print(f"  profile:   {audio.active_profile(mac)}")
        print(f"  battery:   {mon.battery_percent(mac)}%")
    if not cfg["devices"]:
        print("no devices configured — copy config.example.json to "
              "~/.config/maid-watcher/config.json")


def cmd_scan():
    print("Scanning (make devices discoverable)...")
    for mac, name in DeviceMonitor.scan_audio_devices():
        print(f"  {mac}  {name}")


def _sh(*args, timeout=10):
    import subprocess
    try:
        p = subprocess.run(args, capture_output=True, text=True,
                           timeout=timeout)
        return p.stdout.strip().splitlines()[0] if p.stdout.strip() else ""
    except (subprocess.SubprocessError, FileNotFoundError, IndexError):
        return ""


def redact_mac(mac):
    """Keep vendor OUI, hide device-specific bytes: AA:BB:CC:**:**:FF."""
    parts = str(mac).split(":")
    if len(parts) != 6:
        return "** redacted **"
    return ":".join(parts[:3] + ["**", "**", parts[5]])


def cmd_bugreport(cfg, full=False):
    """Print the diagnostics bundle bug reports should include."""
    import platform
    print("### maid-watcher bugreport "
          + ("(FULL macs - trim before posting publicly)"
             if full else "(macs redacted)"))
    print(f"_os: {_sh('sh', '-c', '. /etc/os-release; echo $PRETTY_NAME')}")
    print(f"kernel: {platform.release()}")
    print(f"plasma: {_sh('plasmashell', '--version')}")
    print(f"bluez: {_sh('bluetoothctl', '--version')}")
    print(f"wireplumber: {_sh('sh', '-c', 'rpm -q wireplumber 2>/dev/null || dpkg -s wireplumber 2>/dev/null | grep Version || pacman -Q wireplumber 2>/dev/null')}")
    print(f"pipewire: {_sh('pw-dump', '--version')}")
    bus = dbus.SystemBus()
    mon = DeviceMonitor(bus, lambda *a: None)
    for dev in cfg["devices"]:
        mac = dev["mac"]
        mon.watch(mac)
        shown = mac if full else redact_mac(mac)
        print(f"device {dev.get('name', mac)} [{shown}]: "
              f"connected={mon.is_connected(mac)} "
              f"profile={audio.active_profile(mac)} "
              f"battery={mon.battery_percent(mac)}%")
    print("--- journal maid-watcher (last 15) ---")
    print(_sh("journalctl", "--user", "-u", "maid-watcher", "-n", "15",
              "--no-pager", "-o", "cat"))
    print("--- journal buds-fallback (last 15) ---")
    print(_sh("journalctl", "--user", "-u", "buds-fallback", "-n", "15",
              "--no-pager", "-o", "cat"))
    print("--- kdeconnect phones ---")
    print(_sh("kdeconnect-cli", "-l"))


def main():
    DBusGMainLoop(set_as_default=True)
    cfg = config_mod.load()
    if len(sys.argv) < 2 or sys.argv[1] == "run":
        Daemon(cfg).run()
    elif sys.argv[1] == "status":
        cmd_status(cfg)
    elif sys.argv[1] == "scan":
        cmd_scan()
    elif sys.argv[1] == "bugreport":
        cmd_bugreport(cfg, full="--full" in sys.argv)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
